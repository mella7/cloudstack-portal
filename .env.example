# Copy to .env and fill in. Never commit .env.

# true: no CloudStack and no Terraform needed, everything is simulated.
DRY_RUN=true

# Only needed when DRY_RUN=false. Read by the backend only, never sent to the browser.
CLOUDSTACK_API_URL=https://cloudstack.example.com/client/api
CLOUDSTACK_API_KEY=
CLOUDSTACK_SECRET_KEY=

# Optional tuning (defaults shown)
# MAX_CONCURRENT_JOBS=2
# WORKDIR_RETENTION_HOURS=24
# PLAN_TTL_MINUTES=60
# SHUTDOWN_GRACE_SECONDS=300
# VM_ACTION_TIMEOUT_SECONDS=30
# MIN_DISK_GB=10
# MAX_DISK_GB=500
# MAX_INSTANCES=5
# CORS_ORIGINS=http://localhost:5173
